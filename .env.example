# Firebase Configuration
# Get these values from your Firebase Console (https://console.firebase.google.com)
# Project Settings > General > Your apps > Firebase SDK snippet > Config

# IMPORTANT: Replace these with your actual Firebase project credentials
# These values are safe to commit as they are public (client-side) config

REACT_APP_FIREBASE_API_KEY=your_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
REACT_APP_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id

# To set up:
# 1. Create a Firebase project at https://console.firebase.google.com
# 2. Enable Authentication > Sign-in method > Google
# 3. Enable Realtime Database
# 4. Copy the config values above
# 5. For Netlify: Add these as environment variables in Site settings > Build & deploy > Environment
